# Copiar a .env y rellenar. Nunca subir .env al repositorio. El Makefile lo lee si existe.
# Base local de `make db` (puerto HOUSEFINDER_DB_PORT, por defecto 5442).
DATABASE_URL=postgresql://housefinder:housefinder@127.0.0.1:5442/housefinder
# LLM de código abierto en un servidor propio con la API compatible con OpenAI (ADR-0014).
# En desarrollo, Ollama local: `ollama serve` y LLM_BASE_URL=http://localhost:11434/v1.
# qwen3-14b-hf es qwen3:14b con ventana de 16.384 tokens (infra/ollama/qwen3-14b-hf.Modelfile);
# sin num_ctx, Ollama recorta la conversación a 4.096. Si no cabe en memoria, qwen3-hf (el 8B,
# infra/ollama/qwen3-hf.Modelfile) extrae, pero no sirve para el agente.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_ID=qwen3-14b-hf
# Clave del servidor (vLLM --api-key); vacía para Ollama local.
LLM_API_KEY=
LLM_TIMEOUT_S=600
# Para modelos con razonamiento: none, low, medium o high (vacío = el del servidor).
LLM_REASONING_EFFORT=none
# Claves maestras locales para cifrar perfiles (ADR-0011). Por defecto ~/.housefinder/master.keys.
# Crear con: python -m housefinder.crypto nueva-clave
HOUSEFINDER_KEYS_FILE=

# Acceso (ADR-0028). En el Mac, 1 trabaja sin cuenta con la organización local de desarrollo;
# nunca en el servidor. Sin él, crea tu cuenta: python -m housefinder.accounts alta …
HOUSEFINDER_DEV_ORG=
# Dirección de la web para los enlaces de contraseña (python -m housefinder.accounts).
HOUSEFINDER_WEB_URL=http://localhost:3000
