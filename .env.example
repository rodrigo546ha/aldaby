# Copiar a .env y rellenar. Nunca subir .env al repositorio.
# Base local de `make db` (puerto HOUSEFINDER_DB_PORT, por defecto 5442).
DATABASE_URL=postgresql://housefinder:housefinder@127.0.0.1:5442/housefinder
AWS_REGION=eu-west-1
# LLM vía AWS Bedrock (ADR-0013). `fake` para desarrollo sin cuenta de AWS.
LLM_PROVIDER=bedrock
LLM_MODEL_ID=anthropic.claude-opus-5-5
# Claves maestras locales para cifrar perfiles (ADR-0011). Por defecto ~/.housefinder/master.keys.
# Crear con: python -m housefinder.crypto nueva-clave
HOUSEFINDER_KEYS_FILE=
