# Configuración del servidor (ADR-0040). preparar-servidor.sh la copia a .env y rellena la
# contraseña de la base; lo demás se completa a mano. Nunca subir .env al repositorio.

# Dominio de la beta (Caddy pide el certificado) y dirección de la web para los enlaces de contraseña
HOUSEFINDER_DOMAIN=
HOUSEFINDER_WEB_URL=https://
HOUSEFINDER_HTTP_PORT=80
HOUSEFINDER_HTTPS_PORT=443

POSTGRES_PASSWORD=

# Carpeta con master.keys (uid 10001, 0400), restic.pass (0400) y ssh/ para el Storage Box
HOUSEFINDER_SECRETOS=/srv/housefinder/secretos
# Estado de la vigilancia (último trabajo fallido ya avisado), fuera de las versiones
HOUSEFINDER_ESTADO=/srv/housefinder/estado

# Modelo en la GPU del servidor (perfil `modelo` de compose.yml)
COMPOSE_PROFILES=modelo
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL_ID=qwen3-14b-hf

# Copias con restic al Storage Box: «storagebox» es el Host de secretos/ssh/config (puerto 23)
RESTIC_REPOSITORY=sftp:storagebox:housefinder

# Healthchecks.io: URL de ping de cada comprobación (vacías: los scripts escriben en pantalla)
HC_COPIA_URL=
HC_VIGILANCIA_URL=
