# Copia diaria de la base con restic (ADR-0040). La lanza housefinder-copia.timer.
[Unit]
Description=HouseFinder: copia cifrada de la base
ConditionPathExists=/srv/housefinder/actual/infra/produccion/.env
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=housefinder
ExecStart=/srv/housefinder/actual/infra/produccion/copia.sh
